# =============================================================================
# HPYS 2026 — Production environment template (Oracle Cloud ARM)
# Copy to /opt/hpys/.env and fill secrets. NEVER commit .env with real passwords.
# =============================================================================

# --- Compose build paths (server layout under /opt/hpys) ------------------------
FRONTEND_DIR=./frontend
BACKEND_DIR=./backend
IMAGE_TAG=latest
DEPLOY_BRANCH=main

# --- MySQL mode ----------------------------------------------------------------
# Oracle host MySQL / external IP (current prod):
#   COMPOSE_PROFILES=local-mysql   # starts hpys-mysql if you use the container
#   DB_HOST=130.210.51.96          # or DB_HOST=mysql when using in-compose only
# Hostinger (legacy):
#   COMPOSE_PROFILES=
#   DB_HOST=srv1953.hstgr.io
COMPOSE_PROFILES=local-mysql

# --- Public URLs (baked into frontend image at BUILD time) ---------------------
# MUST include the /api suffix — the SPA appends paths like /reels → /api/reels.
VITE_API_BASE_URL=https://api26.hpys.in/api
VITE_BACKEND_URL=https://api26.hpys.in

# --- File Browser (https://files.hpys.in) --------------------------------------
FILEBROWSER_USERNAME=admin
FILEBROWSER_PASSWORD=CHANGE_ME_FILEBROWSER_PASSWORD
FILEBROWSER_PUBLIC_URL=https://files.hpys.in
FILEBROWSER_IMAGE=filebrowser/filebrowser:v2.32.0

# --- Upload size ---------------------------------------------------------------
UPLOAD_MAX_SIZE=20G
UPLOAD_MAX_BYTES=21474836480
# JSON_BODY_LIMIT=100mb
# BACKEND_MEM_LIMIT=4096m

# --- Backend runtime -----------------------------------------------------------
NODE_ENV=production
PORT=8000

# --- MySQL (Oracle) ------------------------------------------------------------
# Hostname only — never use https://... here.
# Prod currently uses the Oracle host IP (not the Docker hostname "mysql").
DB_HOST=130.210.51.96
DB_PORT=3306
DB_DATABASE=hpys_db
DB_USERNAME=hpys
DB_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG

DB_CONNECTION_LIMIT=20
DB_POOL_MAX_IDLE=10
DB_POOL_IDLE_TIMEOUT_MS=28800000
DB_POOL_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=15000

# Backend aliases (compose falls back to DB_* if you omit these)
LOCAL_DB_HOST=130.210.51.96
LOCAL_DB_PORT=3306
LOCAL_DB_DATABASE=hpys_db
LOCAL_DB_USERNAME=hpys
LOCAL_DB_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG

PROD_DB_HOST=130.210.51.96
PROD_DB_PORT=3306
PROD_DB_DATABASE=hpys_db
PROD_DB_USERNAME=hpys
PROD_DB_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG

# --- Reels sharding (same MySQL host; separate databases) ----------------------
REELS_DB_COUNT=6
REELS_DB_LIMIT_BYTES=3221225472

REELS_METADATA_DB_HOST=130.210.51.96
REELS_METADATA_DB_PORT=3306
REELS_METADATA_DB_NAME=hpys_reels_metadata
REELS_METADATA_DB_USER=hpys
REELS_METADATA_DB_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG

REELS_DB_1_HOST=130.210.51.96
REELS_DB_1_PORT=3306
REELS_DB_1_USER=hpys
REELS_DB_1_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG
REELS_DB_1_NAME=hpys_reels_db_1

REELS_DB_2_HOST=130.210.51.96
REELS_DB_2_PORT=3306
REELS_DB_2_USER=hpys
REELS_DB_2_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG
REELS_DB_2_NAME=hpys_reels_db_2

REELS_DB_3_HOST=130.210.51.96
REELS_DB_3_PORT=3306
REELS_DB_3_USER=hpys
REELS_DB_3_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG
REELS_DB_3_NAME=hpys_reels_db_3

REELS_DB_4_HOST=130.210.51.96
REELS_DB_4_PORT=3306
REELS_DB_4_USER=hpys
REELS_DB_4_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG
REELS_DB_4_NAME=hpys_reels_db_4

REELS_DB_5_HOST=130.210.51.96
REELS_DB_5_PORT=3306
REELS_DB_5_USER=hpys
REELS_DB_5_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG
REELS_DB_5_NAME=hpys_reels_db_5

REELS_DB_6_HOST=130.210.51.96
REELS_DB_6_PORT=3306
REELS_DB_6_USER=hpys
REELS_DB_6_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG
REELS_DB_6_NAME=hpys_reels_db_6

# --- Profile image database (payment QR, avatars) ------------------------------
PROFILE_DB_HOST=130.210.51.96
PROFILE_DB_PORT=3306
PROFILE_DB_NAME=hpys_profile_img
PROFILE_DB_USER=hpys
PROFILE_DB_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG
PROFILE_DB_LIMIT_BYTES=3221225472

# --- Live Instances (ephemeral photo BLOBs) ------------------------------------
INSTANCES_DB_HOST=130.210.51.96
INSTANCES_DB_PORT=3306
INSTANCES_DB_NAME=hpys_instances_db
INSTANCES_DB_USER=hpys
INSTANCES_DB_PASSWORD=CHANGE_ME_APP_PASSWORD_STRONG

# --- CORS (optional extras; defaults already include hpys.in + accommodation Vercel) ---
# Comma-separated origins, no trailing slash
# CORS_ORIGINS=https://another-app.vercel.app

# --- External / accommodation API tokens ----------------------------------------
# Used by /api/external/* (Vercel accommodation app). Pass as Bearer / x-api-token / ?token=
EXTERNAL_API_TOKEN=hpys2026_fixed_secure_token_key
# ACCOMMODATION_API_TOKEN=
# FIXED_API_TOKEN=

# --- SMTP ----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
SMTP_FROM_EMAIL=your-smtp-user@example.com
SMTP_FROM_NAME="HPYS Verification"

# --- WhatsApp Cloud API --------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_WHATSAPP_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME_BUSINESS_ACCOUNT_ID
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_VERIFY_TOKEN
WHATSAPP_OTP_MODE=template
WHATSAPP_OTP_TEMPLATE_NAME=otp
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# WHATSAPP_OTP_TEMPLATE_NAMESPACE=
WHATSAPP_GRAPH_API_VERSION=v19.0
WHATSAPP_MAX_RETRIES=3
# WHATSAPP_REQUIRE_OTP_TEMPLATE=1
# WHATSAPP_SKIP_TEMPLATE_CHECK=0

# --- AWS S3 media uploads (optional). Empty = local ./uploads fallback ---------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional ------------------------------------------------------------------
# LUDOKING_API_KEY=
# DYNAMIC_AUTH_SECRET=hpys2026_secure_key

# --- Bundled MySQL container (hpys-mysql) --------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_INNODB_BUFFER_POOL=512M
MYSQL_PUBLISH=127.0.0.1:3306:3306
# Keep bind mount if you already imported into ./data/mysql
MYSQL_DATA_DIR=./data/mysql
